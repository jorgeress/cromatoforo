#!/usr/bin/env bash
# obsidian-apply: engancha Obsidian a la paleta de pywal.
#
# Uso:
#   obsidian-apply              engancha todos los vaults conocidos
#   obsidian-apply RUTA         engancha solo ese vault
#   obsidian-apply --status     dice como esta la cosa
#
# POR QUE HACE FALTA UN SCRIPT
#   Es el mismo problema que con Zen: el snippet vive DENTRO del vault, y la
#   ruta del vault la eliges tu al crearlo. No se puede versionar una ruta que
#   no se conoce. Obsidian guarda los vaults que conoce en
#   ~/.config/obsidian/obsidian.json, asi que de ahi los sacamos.
#
# QUE HACE
#   1. Enlaza <vault>/.obsidian/snippets/pywal.css al cache de pywal.
#   2. Activa el snippet escribiendo en <vault>/.obsidian/appearance.json, en
#      la lista enabledCssSnippets. Sin ese paso el fichero esta pero apagado,
#      y tendrias que ir a Ajustes -> Apariencia a darle al interruptor.
#
# LIMITE CONOCIDO
#   Si Obsidian esta abierto cuando se toca appearance.json, puede
#   sobrescribirlo al cerrarse. Cierra Obsidian antes, o reinicialo despues.
set -uo pipefail

CACHE="${HOME}/.cache/wal/obsidian.css"
CONF="${HOME}/.config/obsidian/obsidian.json"
MODE="${1:-}"

vaults() {
    [ -f "$CONF" ] || return 0
    python - "$CONF" <<'PY'
import json, sys
try:
    d = json.load(open(sys.argv[1]))
except Exception:
    sys.exit(0)
for v in (d.get("vaults") or {}).values():
    p = v.get("path")
    if p:
        print(p)
PY
}

engancha() {
    local vault="$1"
    [ -d "$vault" ] || { echo "  no existe: $vault"; return 1; }
    local dir="${vault}/.obsidian/snippets"
    mkdir -p "$dir"
    ln -sf "$CACHE" "${dir}/pywal.css"

    # Activar el snippet en appearance.json sin pisar el resto de ajustes.
    local ap="${vault}/.obsidian/appearance.json"
    python - "$ap" <<'PY'
import json, os, sys
ruta = sys.argv[1]
try:
    with open(ruta) as f:
        d = json.load(f)
except Exception:
    d = {}
lista = d.get("enabledCssSnippets") or []
if "pywal" not in lista:
    lista.append("pywal")
d["enabledCssSnippets"] = lista
os.makedirs(os.path.dirname(ruta), exist_ok=True)
with open(ruta, "w") as f:
    json.dump(d, f, indent=2)
PY
    echo "  enganchado: $vault"
}

if [ "$MODE" = "--status" ]; then
    printf "  %-22s %s\n" "paleta generada" "$([ -f "$CACHE" ] && echo si || echo NO)"
    if [ ! -f "$CONF" ]; then
        echo "  Obsidian no se ha abierto nunca (no hay obsidian.json)."
        echo "  Abrelo, crea un vault, cierralo, y vuelve a lanzar obsidian-apply."
        exit 0
    fi
    vaults | while read -r v; do
        ok=$([ "$(readlink -f "${v}/.obsidian/snippets/pywal.css" 2>/dev/null)" = "$CACHE" ] && echo si || echo NO)
        on=$(grep -q '"pywal"' "${v}/.obsidian/appearance.json" 2>/dev/null && echo si || echo NO)
        printf "  %-22s enlace=%s activo=%s\n" "$(basename "$v")" "$ok" "$on"
    done
    exit 0
fi

[ -f "$CACHE" ] || { echo "Falta $CACHE. Lanza wal primero."; exit 1; }

if [ -n "$MODE" ]; then
    engancha "$MODE"
    exit $?
fi

if [ ! -f "$CONF" ]; then
    cat <<'HELP'
Obsidian no se ha abierto nunca todavia.

  1. Abrelo y crea un vault donde quieras (por ejemplo ~/Documents/notas).
  2. Cierra Obsidian.
  3. Vuelve a lanzar: obsidian-apply

Tambien puedes pasarle la ruta a mano: obsidian-apply ~/Documents/notas
HELP
    exit 0
fi

n=0
while read -r v; do
    engancha "$v" && n=$((n+1))
done < <(vaults)
[ "$n" -eq 0 ] && echo "  no se encontro ningun vault en $CONF"
