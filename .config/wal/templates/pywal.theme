# Autogenerado por pywal. NO editar a mano.
# Fuente:  ~/.config/wal/templates/pywal.theme
# Destino: ~/.cache/wal/pywal.theme
# btop lo lee por el enlace ~/.config/btop/themes/pywal.theme

theme[main_bg]="{color0}"
theme[main_fg]="{color7}"
theme[title]="{color7}"
theme[hi_fg]="{color4}"
theme[selected_bg]="{color4}"
theme[selected_fg]="{color0}"
theme[inactive_fg]="{color8}"
theme[graph_text]="{color7}"
theme[meter_bg]="{color8}"
theme[proc_misc]="{color6}"

# Marcos de las cajas
theme[cpu_box]="{color4}"
theme[mem_box]="{color6}"
theme[net_box]="{color5}"
theme[proc_box]="{color3}"
theme[div_line]="{color8}"

# Rampa de temperatura
theme[temp_start]="{color2}"
theme[temp_mid]="{color3}"
theme[temp_end]="{color1}"

# Rampa de CPU
theme[cpu_start]="{color2}"
theme[cpu_mid]="{color6}"
theme[cpu_end]="{color1}"

# Memoria: libre / cacheada / disponible / usada
theme[free_start]="{color2}"
theme[free_mid]="{color6}"
theme[free_end]="{color4}"

theme[cached_start]="{color5}"
theme[cached_mid]="{color4}"
theme[cached_end]="{color6}"

theme[available_start]="{color3}"
theme[available_mid]="{color6}"
theme[available_end]="{color2}"

theme[used_start]="{color2}"
theme[used_mid]="{color3}"
theme[used_end]="{color1}"

# Red
theme[download_start]="{color6}"
theme[download_mid]="{color4}"
theme[download_end]="{color5}"

theme[upload_start]="{color3}"
theme[upload_mid]="{color1}"
theme[upload_end]="{color5}"

# Lista de procesos
theme[process_start]="{color2}"
theme[process_mid]="{color3}"
theme[process_end]="{color1}"
