# Autogenerado por pywal. NO editar a mano.
# Fuente:  ~/.config/wal/templates/cava-config
# Destino: ~/.cache/wal/cava-config
# cava lo lee por el enlace ~/.config/cava/config

[general]
framerate = 60
autosens = 1
bar_width = 2
bar_spacing = 1
lower_cutoff_freq = 50
higher_cutoff_freq = 10000

[input]
method = pulse
source = auto

[output]
method = ncurses
channels = stereo
mono_option = average

[color]
# Fondo transparente: se queda el del terminal (kitty ya va a 0.88)
background = default
gradient = 1
# color9-15 suelen duplicar a color1-7 en pywal, asi que solo uso 0-8
gradient_color_1 = '{color1}'
gradient_color_2 = '{color2}'
gradient_color_3 = '{color4}'
gradient_color_4 = '{color5}'
gradient_color_5 = '{color3}'
gradient_color_6 = '{color6}'
gradient_color_7 = '{color8}'
gradient_color_8 = '{color7}'

[smoothing]
noise_reduction = 55

[eq]
1 = 1
2 = 1
3 = 1
4 = 1
5 = 1
