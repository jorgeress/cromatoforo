{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // El logo es un fichero de texto aparte: ~/.config/fastfetch/logo.txt
  // Tipo "file" = fastfetch sustituye $1..$9 por los colores del terminal.
  // Como kitty coge su paleta de pywal, el logo sigue al wallpaper solo,
  // sin plantilla ni regeneracion. Si tu arte ya trae colores ANSI propios,
  // cambia "file" por "file-raw" y los respetara tal cual.
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/logo.txt",
    "padding": {
      "top": 1,
      "left": 2,
      "right": 4
    }
  },

  // Los nombres de color ("blue", "magenta"...) apuntan a la paleta ANSI del
  // terminal, o sea a pywal. Nada de hex hardcodeado.
  "display": {
    "separator": "  ",
    "color": {
      "keys": "blue",
      "title": "cyan"
    },
    "key": {
      "width": 13
    },
    "size": {
      "ndigits": 1
    },
    "percent": {
      "type": 3
    }
  },

  "modules": [
    {
      "type": "title",
      "color": {
        "user": "green",
        "at": "black",
        "host": "blue"
      }
    },
    {
      "type": "separator",
      "string": "─"
    },

    // ── Sistema ──────────────────────────────────────────
    { "type": "os",           "key": "  OS" },
    { "type": "host",         "key": " 󰌢 Equipo" },
    { "type": "kernel",       "key": "  Kernel" },
    { "type": "uptime",       "key": " 󰅐 Encendido" },
    { "type": "packages",     "key": " 󰏖 Paquetes" },
    { "type": "shell",        "key": "  Shell" },
    { "type": "terminal",     "key": "  Terminal" },
    { "type": "terminalfont", "key": "  Fuente term" },
    { "type": "wm",           "key": "  WM" },
    "break",

    // ── Hardware ─────────────────────────────────────────
    { "type": "cpu",          "key": "  CPU", "showPeCoreCount": true },
    { "type": "gpu",          "key": " 󰢮 GPU" },
    { "type": "memory",       "key": "  Memoria" },
    { "type": "swap",         "key": " 󰓡 Swap" },
    { "type": "disk",         "key": "  Disco" },
    { "type": "battery",      "key": "  Bateria" },
    "break",

    // ── Escritorio y estetica ────────────────────────────
    // Quitados font/theme/icons: leen ~/.config/gtk-3.0/settings.ini, que
    // esta vacio, asi que solo dejaban huecos en blanco.
    // El modulo "wallpaper" nativo no reconoce awww, asi que tiro del
    // fichero de estado que ya mantiene wall.sh.
    { "type": "display",      "key": " 󰍹 Pantalla" },
    { "type": "cursor",       "key": " 󰆿 Cursor" },
    {
      "type": "command",
      "key": " 󰸉 Wallpaper",
      "text": "basename \"$(cat \"$HOME/.cache/current_wallpaper\" 2>/dev/null)\" 2>/dev/null || echo '-'"
    },
    "break",

    // ── Multimedia y red ─────────────────────────────────
    { "type": "player",       "key": " 󰥠 Reproductor" },
    { "type": "media",        "key": " 󰎈 Sonando" },
    { "type": "sound",        "key": " 󰕾 Audio" },
    { "type": "wifi",         "key": " 󰖩 Wifi" },
    { "type": "localip",      "key": " 󰩠 IP local" },
    "break",

    {
      "type": "colors",
      "symbol": "circle",
      "block": {
        "width": 3
      }
    }
  ]
}
