{
    "label" : "lock",
    "action" : "hyprlock --grace 2",
    "text" : "  Bloquear",
    "keybind" : "l"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "  Suspender",
    "keybind" : "u"
}
{
    "label" : "logout",
    "action" : "hyprctl dispatch 'hl.dsp.exit()'",
    "text" : "  Salir",
    "keybind" : "e"
}
{
    "label" : "hibernate",
    "action" : "systemctl hibernate",
    "text" : "  Hibernar",
    "keybind" : "h"
}
{
    "label" : "reboot",
    "action" : "systemctl reboot",
    "text" : "  Reiniciar",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "systemctl poweroff",
    "text" : "  Apagar",
    "keybind" : "s"
}
